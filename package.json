{
  "name": "easyslide",
  "version": "0.3.0",
  "description": "EasySlide AI presentation workspace",
  "private": true,
  "scripts": {
    "setup:test": "uv sync --extra test && cd frontend && npm install",
    "setup:hooks": "chmod +x scripts/setup_git_hooks.sh && ./scripts/setup_git_hooks.sh",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "uv run pytest backend/tests/ -v",
    "test:frontend": "cd frontend && npm test -- --run",
    "test:release-gates": "uv run pytest backend/tests/unit/test_acceptance_summary_validators.py backend/tests/unit/test_media_acceptance_signoff.py backend/tests/unit/test_release_staging_check.py -q",
    "test:e2e": "cd frontend && npm run test:e2e",
    "test:e2e:ui": "cd frontend && npm run test:e2e:ui",
    "test:docker": "chmod +x scripts/test_docker_environment.sh && ./scripts/test_docker_environment.sh",
    "test:all": "npm run test && npm run test:docker && npm run test:e2e",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "uv run flake8 backend/ --exclude=backend/dist,backend/build --count --select=E9,F63,F7,F82 --show-source --statistics",
    "lint:frontend": "cd frontend && npm run lint",
    "check:media-acceptance": "python scripts/check_media_acceptance_signoff.py",
    "check:release-staging": "python scripts/check_release_staging.py",
    "smoke:packaged": "python scripts/packaged_smoke/run_packaged_smoke.py",
    "generate:video-acceptance": "python scripts/generate_video_acceptance_summary.py",
    "validate:media-artifacts": "python scripts/validate_media_artifacts.py",
    "validate:fish-acceptance": "python scripts/validate_fish_acceptance_summary.py",
    "validate:video-acceptance": "python scripts/validate_video_acceptance_summary.py",
    "dev": "docker compose up",
    "dev:backend": "cd backend && uv run python app.py",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "docker compose build",
    "build:desktop": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "build:desktop:mac": "bash scripts/build-desktop-mac.sh",
    "start": "docker compose up -d",
    "stop": "docker compose down",
    "quick-check": "npm run lint && npm run test:frontend && npm run test:backend"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

