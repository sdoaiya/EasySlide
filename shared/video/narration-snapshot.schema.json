{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cozyslide.local/schemas/narration-snapshot.schema.json",
  "title": "Narration export snapshot",
  "type": "object",
  "required": ["schema_version", "project_id", "narration_policy", "pages", "export_config", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "narration_policy": {
      "enum": ["confirmed_only", "export_only_auto_fill", "allow_silent_pages"]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_id", "order_index", "text", "segments", "silent"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "order_index": {"type": "integer", "minimum": 0},
          "narration_version_id": {"type": ["string", "null"]},
          "content_hash": {"type": ["string", "null"]},
          "mode": {"enum": ["single", "dialogue"]},
          "language": {"type": "string"},
          "text": {"type": "string"},
          "segments": {"type": "array"},
          "silent": {"type": "boolean"}
        }
      }
    },
    "scene_manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_id", "path", "sha256"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "native_scene_bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_id", "path", "sha256"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "export_config": {"type": "object"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
