{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyslide.local/schemas/content/podcast-workspace.schema.json",
  "title": "EasySlide Podcast Workspace Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "format", "language", "speakers", "segments", "mixing", "cover"],
  "properties": {
    "schema_version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "format": { "enum": ["single", "dialogue"] },
    "language": { "type": "string", "minLength": 2, "maxLength": 16 },
    "speakers": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/speaker" } },
    "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
    "mixing": { "$ref": "#/$defs/mixing" },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_ref", "title", "subtitle"],
      "properties": {
        "asset_ref": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "subtitle": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "format": { "const": "single" } }, "required": ["format"] },
      "then": { "properties": { "speakers": { "maxItems": 1 } } }
    },
    {
      "if": { "properties": { "format": { "const": "dialogue" } }, "required": ["format"] },
      "then": { "properties": { "speakers": { "minItems": 2 } } }
    }
  ],
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker_id", "name", "voice_ref"],
      "properties": {
        "speaker_id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "voice_ref": { "type": "string", "minLength": 1 }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "speaker_id", "text", "locked", "audio_cues"],
      "properties": {
        "segment_id": { "$ref": "#/$defs/stableId" },
        "speaker_id": { "$ref": "#/$defs/stableId" },
        "text": { "type": "string", "minLength": 1 },
        "locked": { "type": "boolean" },
        "audio_cues": { "type": "array", "items": { "$ref": "#/$defs/audioCue" } },
        "source_ref": { "type": ["string", "null"] },
        "source_kind": { "enum": ["audio", "transcript", null] }
      }
    },
    "audioCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cue_id", "kind", "asset_ref", "offset_ms", "gain_db"],
      "properties": {
        "cue_id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["bgm", "sfx"] },
        "asset_ref": { "type": "string", "minLength": 1 },
        "offset_ms": { "type": "integer", "minimum": 0 },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 }
      }
    },
    "mixing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bgm_asset_ref", "ducking", "fade_in_ms", "fade_out_ms"],
      "properties": {
        "bgm_asset_ref": { "type": ["string", "null"] },
        "ducking": { "type": "boolean" },
        "fade_in_ms": { "type": "integer", "minimum": 0 },
        "fade_out_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
