{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cozyslide.local/schemas/video-render-snapshot.schema.json",
  "title": "Video render snapshot",
  "type": "object",
  "required": ["schema_version", "project_id", "narration_snapshot", "pages", "renderer", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "narration_snapshot": {"$ref": "#/$defs/sourceRef"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page_id", "audio_track", "audio_timeline", "motion_manifest", "scene_manifest", "native_scene_bundle", "visual_renderer", "fallback_from", "fallback_reason"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "audio_track": {"anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
          "audio_timeline": {"$ref": "#/$defs/artifactRef"},
          "motion_manifest": {"anyOf": [{"$ref": "#/$defs/motionRef"}, {"type": "null"}]},
          "scene_manifest": {"anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
          "native_scene_bundle": {"anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
          "visual_renderer": {"enum": ["hyperframes", "browser_frames", "ken_burns", "static_frame"]},
          "fallback_from": {"enum": ["hyperframes", "browser_frames", null]},
          "fallback_reason": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "renderer": {
      "type": "object",
      "required": ["width", "height", "fps", "hyperframes_enabled"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "integer", "minimum": 1},
        "hyperframes_enabled": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string"}
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "required": ["page_id", "path", "sha256"],
      "properties": {
        "page_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "motionRef": {
      "type": "object",
      "required": ["page_id", "path", "sha256", "scene_manifest_sha256"],
      "properties": {
        "page_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scene_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
