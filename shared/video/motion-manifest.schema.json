{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cozyslide.local/schemas/motion-manifest.schema.json",
  "title": "Motion Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "page_id",
    "scene_manifest_sha256",
    "duration_ms",
    "timing_quality",
    "transition",
    "camera",
    "elements",
    "captions",
    "fallback",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "page_id": {"type": "string", "minLength": 1},
    "scene_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "duration_ms": {"type": "integer", "minimum": 1},
    "timing_quality": {
      "enum": ["word_exact", "segment_exact", "aligned", "estimated"]
    },
    "transition": {"$ref": "#/$defs/transition"},
    "camera": {"$ref": "#/$defs/camera"},
    "elements": {
      "type": "array",
      "items": {"$ref": "#/$defs/elementMotion"}
    },
    "captions": {
      "type": "array",
      "items": {"$ref": "#/$defs/caption"}
    },
    "fallback": {"$ref": "#/$defs/fallback"},
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "transition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "duration_ms", "direction"],
          "properties": {
            "type": {"const": "cut"},
            "duration_ms": {"const": 0},
            "direction": {"type": "null"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "duration_ms", "direction"],
          "properties": {
            "type": {"const": "crossfade"},
            "duration_ms": {"type": "integer", "minimum": 1},
            "direction": {"type": "null"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "duration_ms", "direction"],
          "properties": {
            "type": {"const": "push"},
            "duration_ms": {"type": "integer", "minimum": 1},
            "direction": {"enum": ["left", "right", "up", "down"]}
          },
          "additionalProperties": false
        }
      ]
    },
    "camera": {
      "type": "object",
      "required": ["preset", "start_ms", "end_ms"],
      "properties": {
        "preset": {
          "enum": ["static", "subtle_push", "pan_left", "pan_right"]
        },
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "cue": {
      "type": "object",
      "required": ["basis", "segment_id", "precision"],
      "properties": {
        "basis": {"enum": ["page", "segment_window", "segment", "word"]},
        "segment_id": {"type": ["string", "null"]},
        "precision": {"enum": ["coarse", "exact"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"basis": {"const": "page"}},
            "required": ["basis"]
          },
          "then": {
            "properties": {"segment_id": {"type": "null"}}
          },
          "else": {
            "properties": {
              "segment_id": {"type": "string", "minLength": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "elementMotion": {
      "type": "object",
      "required": [
        "element_id",
        "effect",
        "start_ms",
        "duration_ms",
        "easing",
        "cue"
      ],
      "properties": {
        "element_id": {"type": "string", "minLength": 1},
        "effect": {
          "enum": [
            "fade_in",
            "fade_up",
            "slide_in",
            "scale_in",
            "mask_reveal",
            "chart_reveal",
            "count_up",
            "highlight",
            "drift"
          ]
        },
        "start_ms": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 1},
        "easing": {
          "enum": [
            "none",
            "linear",
            "power1.out",
            "power2.out",
            "power3.out",
            "power4.out",
            "sine.inOut",
            "expo.out"
          ]
        },
        "cue": {"$ref": "#/$defs/cue"}
      },
      "additionalProperties": false
    },
    "caption": {
      "type": "object",
      "required": [
        "segment_id",
        "speaker_id",
        "text",
        "start_ms",
        "end_ms",
        "granularity"
      ],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "speaker_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "granularity": {"enum": ["page", "segment", "sentence", "word"]}
      },
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "required": ["strategy", "reason"],
      "properties": {
        "strategy": {
          "enum": ["browser_frames", "region_focus", "ken_burns", "static_frame"]
        },
        "reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"timing_quality": {"const": "estimated"}},
        "required": ["timing_quality"]
      },
      "then": {
        "properties": {
          "elements": {
            "items": {
              "properties": {
                "cue": {
                  "properties": {
                    "basis": {"enum": ["page", "segment_window"]},
                    "precision": {"const": "coarse"}
                  }
                }
              }
            }
          },
          "captions": {
            "items": {
              "properties": {
                "granularity": {"enum": ["page", "segment"]}
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
